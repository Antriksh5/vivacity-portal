# Registration submissions: Google Apps Script production web-app URL (not the Sheet URL).
VITE_GOOGLE_SHEET_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Enable CA validation and referral tracking. Local Vite proxy targets port 8001.
# When enabled, set REGISTRATION_SHEET_URL on the CA server for sheet exports.
VITE_CA_API_URL=/ca-api
VITE_CA_PORTAL_URL=http://127.0.0.1:5174/caportal

# Existing registration images are hosted in this Cloudinary account.
VITE_CLOUDINARY_CLOUD_NAME=doxipu0v7

# Only needed when running the asset upload scripts, not for displaying images:
# VITE_CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# VITE_ variables are public. Never prefix a secret with VITE_.

# Main Road to Vivacity landing page.
VITE_MAIN_SITE_URL=http://127.0.0.1:5174/

# Optional: separate the router root from Vite's asset base for a shared domain.
# VITE_ROUTER_BASENAME=/
