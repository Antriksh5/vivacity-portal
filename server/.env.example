# Local preview; existing MySQL support is retained by setting DB_DIALECT=mysql.
DB_DIALECT=sqlite
SQLITE_STORAGE=./ca-local.sqlite
HOST=127.0.0.1
PORT=8001
SECRET_TOKEN=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# For MySQL, create the database first; tables are created on startup.
# DB_NAME=vivacity_ca
# DB_USER=your_user
# DB_PASS=your_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Optional exports. The current registration sheet uses a flat row payload.
# REGISTRATION_SHEET_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# CA signup rows go to Campus Ambassadors in the same spreadsheet by default.
# Set CA_SHEET_URL only to use another deployment/spreadsheet.
# CA_SHEET_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# Older CA/registration exports use { data: ... } payloads.
# SHEET_API1=
# SHEET_API_GDG_1=
# SHEET_API2=
# SHEET_API_GDG_2=
