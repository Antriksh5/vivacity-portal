# Set these in the API host's environment (e.g. Render). Never commit real values.
NODE_ENV=production
HOST=0.0.0.0
# Most hosts supply PORT themselves.

# Must be a real host environment variable: Node reads it before any .env file loads.
NODE_OPTIONS=--network-family-autoselection-attempt-timeout=2000

# Copy SECRET_TOKEN and REGISTRATION_SHEET_URL from server/.env.
SECRET_TOKEN=replace-with-the-value-from-server-.env
REGISTRATION_SHEET_URL=replace-with-the-value-from-server-.env

# Origins only: no paths, no trailing slashes.
CORS_ORIGINS=https://YOUR-CA-PORTAL-HOST,https://YOUR-REGISTRATION-HOST

# Built-in SQLite file: no database service to install. The server creates it on first start.
# Logins and referral codes depend on this file, so keep it across restarts and redeploys.
DB_DIALECT=sqlite
SQLITE_STORAGE=./ca.sqlite
